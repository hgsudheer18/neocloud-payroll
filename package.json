{
  "name": "neocloud-payroll",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Calculates, reconciles and visualizes one pay period of payroll, time and absence for NeoCloud's Workday implementation.",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "generate": "node --experimental-strip-types scripts/generate-data.ts",
    "report": "node --experimental-strip-types scripts/report.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "marked": "^18.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.2"
  }
}
